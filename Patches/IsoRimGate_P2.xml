<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VGE Pack, pawn batch P2: the exoworm hovers (VGE: VEF floating) by IsoRim Api 32's hoverHeight /
     hoverBob; an older IsoRim does not know these fields, so they come in here behind the gate. -->
<Patch>
  <Operation Class="IsoRimVGEPack.PatchOperation_IfIsoRimApi">
    <minVersion>32</minVersion>
    <apply Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VGE_Exoworm"]</xpath>
      <value>
        <hoverHeight>0.15</hoverHeight>
        <hoverBob>0.03</hoverBob>
      </value>
    </apply>
  </Operation>
</Patch>
