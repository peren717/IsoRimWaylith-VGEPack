    <minVersion>31</minVersion>
    <apply Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VGE_EnemyPointDefenseTurret"]</xpath>
      <value>
