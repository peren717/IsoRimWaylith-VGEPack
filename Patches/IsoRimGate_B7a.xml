    <minVersion>31</minVersion>
    <apply Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VGE_EnemyAnticraftBeam"]</xpath>
      <value>
        <roofModel>Models/vge_gun_pedestal_9x9.obj</roofModel>
        <topThroughRoof>true</topThroughRoof>
      </value>
    </apply>
  </Operation>
</Patch>
