      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>31</minVersion>
    <apply Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VGE_EnemyGaussHowitzer"]</xpath>
      <value>
        <roofModel>Models/vge_gun_pedestal_5x5.obj</roofModel>
        <topThroughRoof>true</topThroughRoof>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>31</minVersion>
    <apply Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VGE_EnemyJavelinLauncher"]</xpath>
      <value>
        <roofModel>Models/vge_gun_pedestal_5x5.obj</roofModel>
