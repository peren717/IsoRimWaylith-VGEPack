<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VGE Pack, batch B1b: the electric thrusters charge bar sits centred in the charge slot on the top of each
     model (barAt, model space facing north: x, height, z), resized so the whole bar with its dark background fits inside
     the slot with a small inset (barScale: length, thickness; VGE draws a 0.9 x 0.3 bar plus a 0.15 margin; the slot is
     0.28 wide and 1.16 / 0.82 / 0.95 long). Needs IsoRim Api 36; an older IsoRim does not know these fields (an XML error
     in Defs/), so they come in here; there the bar stays where IsoRim puts it. -->
<Patch>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>36</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VGE_SmallElectricThruster"]</xpath>
      <value>
        <barAt>(0, 1.68, 0.28)</barAt>
        <barScale>(1.14, 0.49)</barScale>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>36</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VGE_LargeElectricThruster"]</xpath>
      <value>
        <barAt>(0, 1.68, 0.51)</barAt>
        <barScale>(0.76, 0.49)</barScale>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>36</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VGE_GiantElectricThruster"]</xpath>
      <value>
        <barAt>(0, 1.68, 0.925)</barAt>
        <barScale>(0.90, 0.49)</barScale>
      </value>
    </apply>
  </Operation>
</Patch>
