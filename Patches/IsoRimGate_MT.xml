<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VGE Pack, batch MT: the mechanoid ship guns' pedestals (roofModel) and guns over the roof (topThroughRoof) need
     IsoRim Api 31, one gate per gun (no error without Chapter 2). -->
<Patch>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>31</minVersion>
    <apply Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VGE_MassDriver"]</xpath>
      <value>
        <roofModel>Models/vge_mgun_pedestal_5x5.obj</roofModel>
        <topThroughRoof>true</topThroughRoof>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>31</minVersion>
    <apply Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VGE_HeavyChargeAnnihilator"]</xpath>
      <value>
        <roofModel>Models/vge_mgun_pedestal_3x3.obj</roofModel>
        <topThroughRoof>true</topThroughRoof>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>31</minVersion>
    <apply Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VGE_MechanoidChargeBattery"]</xpath>
      <value>
        <roofModel>Models/vge_mgun_pedestal_5x5.obj</roofModel>
        <topThroughRoof>true</topThroughRoof>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>31</minVersion>
    <apply Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VGE_MechanoidInfernoArtillery"]</xpath>
      <value>
        <roofModel>Models/vge_mgun_pedestal_5x5.obj</roofModel>
        <topThroughRoof>true</topThroughRoof>
      </value>
    </apply>
  </Operation>
</Patch>
