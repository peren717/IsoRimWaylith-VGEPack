    <defName>R3D_VGE_EnemyGravjumperEngine</defName>
    <thingDef>VGE_EnemyGravjumperEngine</thingDef>
    <model>Models/vge_e_gravjumper_engine.obj</model>
    <builtFor>(1, 1)</builtFor>
    <bobModel>Models/vge_e_gravjumper_orb.obj</bobModel>
    <bobHeight>0.10</bobHeight>
  </IsoRim.ModelDef>
