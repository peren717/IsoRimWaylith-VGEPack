    <model>Models/vge_operator_subpersona_core.obj</model>
    <builtFor>(1, 1)</builtFor>
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>   <!-- Biotech -->
    <defName>R3D_VGE_GravshipBasicRecharger</defName>
    <thingDef>VGE_GravshipBasicRecharger</thingDef>
    <model>Models/vge_basic_recharger.obj</model>
    <builtFor>(1, 1)</builtFor>
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>   <!-- Biotech -->
