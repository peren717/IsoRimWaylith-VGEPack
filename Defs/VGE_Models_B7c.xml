    <model>Models/vge_e_signal_jammer.obj</model>
    <builtFor>(2, 2)</builtFor>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef MayRequire="vanillaexpanded.gravship2">
    <defName>R3D_VGE_EnemyGravshipLight_red</defName>
