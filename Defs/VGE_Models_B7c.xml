<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VGE Pack, batch B7c: VGE Chapter 2 enemy ship parts made straight from the player models (auto-approved):
     shield generator, grav field extender (cyan lights red), ancient gravmine (darker, bronze spikes), signal jammer (lens and display
     lit red), the enemy gravship light (IsoRim's red ancient emergency light), the small / lateral / giant thrusters (tan exhaust red;
     wall-height machines like the player ones, wallFit 1.65: user decision, an exception to the storey rule). All under the storey; MayRequire Chapter 2. The
     large shield generator (2.45) and grav field amplifier (2.02) are the player models too (user decision: under an enemy ship
     roof IsoRim's roof clipping hides what rises above it); the enemy oxygen pump has VGE's square vent hood. -->
<Defs>
  <IsoRim.ModelDef MayRequire="vanillaexpanded.gravship2">
    <defName>R3D_VGE_EnemyShieldGenerator</defName>
    <thingDef>VGE_EnemyShieldGenerator</thingDef>
    <model>Models/vge_e_shield_generator.obj</model>
    <builtFor>(3, 3)</builtFor>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef MayRequire="vanillaexpanded.gravship2">
    <defName>R3D_VGE_EnemyGravFieldExtender</defName>
    <thingDef>VGE_EnemyGravFieldExtender</thingDef>
    <model>Models/vge_e_grav_field_extender.obj</model>
    <builtFor>(1, 1)</builtFor>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef MayRequire="vanillaexpanded.gravship2">
    <defName>R3D_VGE_AncientGravmine</defName>
    <thingDef>VGE_AncientGravmine</thingDef>
    <model>Models/vge_e_gravmine.obj</model>
    <builtFor>(1, 1)</builtFor>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef MayRequire="vanillaexpanded.gravship2">
