    <defName>R3D_VGE_AncientSignalJammer</defName>
    <thingDef>VGE_AncientSignalJammer</thingDef>
    <model>Models/vge_ancient_signal_jammer.obj</model>
    <builtFor>(3, 3)</builtFor>
    <ignoreRotation>true</ignoreRotation>
  </IsoRim.ModelDef>
