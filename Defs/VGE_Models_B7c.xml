    <model>Models/vge_e_lateral_thruster.obj</model>
    <builtFor>(2, 2)</builtFor>
    <wallFit>1.65</wallFit>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef MayRequire="vanillaexpanded.gravship2">
    <defName>R3D_VGE_EnemyGiantThruster</defName>
    <thingDef>VGE_EnemyGiantThruster</thingDef>
    <model>Models/vge_e_giant_thruster.obj</model>
    <builtFor>(3, 3)</builtFor>
    <wallFit>1.65</wallFit>
  </IsoRim.ModelDef>
  <!-- ancient signal jammer (new model, approved): every rotation of VGE's art is the same picture -->
