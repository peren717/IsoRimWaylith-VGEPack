    <wallMounted>true</wallMounted>
    <groundShadow>false</groundShadow>
    <builtFor>(1, 1)</builtFor>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef MayRequire="vanillaexpanded.gravship2">
    <defName>R3D_VGE_EnemySmallThruster</defName>
    <thingDef>VGE_EnemySmallThruster</thingDef>
    <model>Models/vge_e_small_thruster.obj</model>
