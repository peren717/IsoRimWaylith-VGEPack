<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VGE Pack, batch B5: the ship guns on tall open frames (user rules 2026-10-24): a frame taller than a storey
     (IsoRimZ height rule: no floor over it), legs at the corners, machinery over head height; the gun (topModel) turns on a
     fixed pedestal (square block, round tier) over the roof. The pedestal (roofModel) and the gun rising through the roof
     (topThroughRoof) need IsoRim Api 31: Patches/IsoRimGate_B5.xml adds them; an older IsoRim draws the frame and the gun, the
     gun cut by a roof over it. Not the three compact 1x1 turrets. Chapter 2 guns: MayRequire. -->
<Defs>
  <IsoRim.ModelDef>
    <defName>R3D_VGE_GaussGun</defName>
    <thingDef>VGE_GaussGun</thingDef>
    <model>Models/vge_gun_frame_3x3.obj</model>
    <builtFor>(3, 3)</builtFor>
    <topModel>Models/vge_gun_gauss.obj</topModel>
    <topHeight>2.33</topHeight>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>
