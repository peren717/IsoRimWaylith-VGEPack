<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- IsoRim Waylith - VGE Pack, model batch B8a1 (2026-10-24): rare mechanoid buildings, first half. Low-poly models built
       from VGE's own textures (tools/make_vge_b8a.py, vge_b8a.mtl); everything under the 1.60 storey (mechanoid ships are
       roofed over them), the thrusters wall-fit as the pack's others. The mechanoid grav engine's and the grav tether's
       orbs are IsoRim bob parts sitting low in the base's pit (VGE's flat bobbing orb is left out under a model:
       Source/MechOrbs.cs); the targeting relay's obelisk hovers as IsoRim's mech relay crystal does. Chapter 2 things are
       skipped quietly without Chapter 2. Not here: the mechanoid turrets (ship-gun batch), the hull platform (a wall). -->

  <IsoRim.ModelDef>
    <defName>R3D_VGE_MechanoidGravEngine</defName>
    <thingDef>VGE_MechanoidGravEngine</thingDef>
    <model>Models/vge_mech_grav_engine.obj</model>
    <builtFor>(3, 3)</builtFor>
    <bobModel>Models/vge_mech_grav_engine_orb.obj</bobModel>
    <bobHeight>0.10</bobHeight>
    <bobPeriod>500</bobPeriod>   <!-- VGE's own orb period -->
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>
    <defName>R3D_VGE_MechanoidGravTether</defName>
    <thingDef>VGE_MechanoidGravTether</thingDef>
    <model>Models/vge_mech_grav_tether.obj</model>
    <builtFor>(5, 5)</builtFor>
    <bobModel>Models/vge_mech_grav_tether_orb.obj</bobModel>
    <bobHeight>0.10</bobHeight>
    <bobPeriod>500</bobPeriod>
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>
