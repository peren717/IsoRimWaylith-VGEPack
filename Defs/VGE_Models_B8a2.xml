<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- IsoRim Waylith - VGE Pack, model batch B8a2 (2026-10-24): rare mechanoid buildings, second half. Low-poly models built
       from VGE's own textures (tools/make_vge_b8a2.py, vge_b8a2.mtl); everything under the 1.60 storey. The overshield
       generator shows its dark sphere while the shield is down (pack state "off", Source/ModelStates.cs, as VGE's _Off
       art). The auxiliary processor and the resource crate have three looks each, picked as VGE's Graphic_Random picks
       its texture (IsoRim: variants by the thing's ID, textures in name order A, B, C). Chapter 2 things are skipped
       quietly without Chapter 2. -->

  <IsoRim.ModelDef>
    <defName>R3D_VGE_MechanoidArtilleryLoader</defName>
    <thingDef>VGE_MechanoidArtilleryLoader</thingDef>
    <model>Models/vge_mech_artillery_loader.obj</model>
    <builtFor>(1, 3)</builtFor>
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>
    <defName>R3D_VGE_MechanoidGravcapacitor</defName>
    <thingDef>VGE_MechanoidGravcapacitor</thingDef>
    <model>Models/vge_mech_gravcapacitor.obj</model>
    <builtFor>(2, 3)</builtFor>
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>
    <defName>R3D_VGE_MechanoidOvershieldGenerator</defName>
    <thingDef>VGE_MechanoidOvershieldGenerator</thingDef>
    <model>Models/vge_mech_overshield.obj</model>
    <builtFor>(3, 3)</builtFor>
    <byState>
      <li><state>off</state><model>Models/vge_mech_overshield_off.obj</model></li>
    </byState>
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>
