    <model>Models/vge_oxygen_valve.obj</model>
    <builtFor>(1, 1)</builtFor>
    <byState>
      <li><state>off</state><model>Models/vge_oxygen_valve_off.obj</model></li>
    </byState>
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>
