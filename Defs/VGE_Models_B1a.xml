<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- IsoRim Waylith - VGE Pack, model batch B1a: life support, heat and fuel (2026-10-23). Low-poly models built only
       from what Vanilla Gravship Expanded's own textures show (toolsmake_vge_b1a.py). Format: IsoRim's DefsModels.xml.
       Paths are relative to this mod's folder. All built facing north (VGE's _north art); fixed colours (vge_b1a.mtl).
       A thingDef that is not loaded (Chapter 2 absent) is skipped quietly by IsoRim.
       byState: the state is named by the pack (Pack.cs, IsoRim Api.AddModelState): "empty" (life support out of algae,
       VEF's Graphic_RefuelableSingle), "off" (valve switched off, the vanilla _Off graphic), "hot" (heatsink holding heat,
       VGE's _Overlay), "cooldown" (gravheat absorber on cooldown, VGE's _Cooldown). -->

  <IsoRim.ModelDef>
    <defName>R3D_VGE_LargeOxygenTank</defName>
    <thingDef>VGE_LargeOxygenTank</thingDef>
    <model>Models/vge_large_oxygen_tank.obj</model>
    <builtFor>(3, 3)</builtFor>
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>
    <defName>R3D_VGE_SmallOxygenTank</defName>
    <thingDef>VGE_SmallOxygenTank</thingDef>
    <model>Models/vge_small_oxygen_tank.obj</model>
    <builtFor>(2, 2)</builtFor>
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>   <!-- Ch.2 -->
    <defName>R3D_VGE_AuxiliaryOxygenTank</defName>
    <thingDef>VGE_AuxiliaryOxygenTank</thingDef>
    <model>Models/vge_aux_oxygen_tank.obj</model>
    <builtFor>(1, 1)</builtFor>
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>
    <defName>R3D_VGE_IndustrialOxygenPump</defName>
    <thingDef>VGE_IndustrialOxygenPump</thingDef>
    <model>Models/vge_industrial_oxygen_pump.obj</model>
    <builtFor>(1, 1)</builtFor>
    <wallFit>1.2</wallFit>
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>
